OPENAI_API_KEY=sk-your-key-here
# General chat/classification model. Food resolution uses the task-specific model below.
NOMVA_LLM_MODEL=gpt-5.4-nano
NOMVA_FOOD_RESOLUTION_MODEL=gpt-5.6-luna
# Current-menu discovery model. Successful results are validated and cached.
NOMVA_WEB_FOOD_MODEL=gpt-5.6-luna
NOMVA_WEB_FOOD_TIMEOUT_MS=18000
NOMVA_FOOD_RESOLUTION_AFTER_WEB_DEADLINE_MS=8000
NOMVA_CONTEXT_MODEL=gpt-5.4-mini
PORT=3000
STATE_ENCRYPTION_KEY=replace-with-a-long-random-secret
ANALYTICS_ENABLED=1
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Optional: leave blank to reuse STATE_ENCRYPTION_KEY for one-way analytics hashes.
ANALYTICS_HASH_SALT=
# Optional: defaults to ./data/nomva-analytics.sqlite
ANALYTICS_DB_PATH=
# Optional: writable learned menu catalog; defaults to ./data/food-knowledge.sqlite
FOOD_KNOWLEDGE_DB_PATH=
VOWNTIL_BREACH_API_TOKEN=replace-with-a-long-random-token
VOWNTIL_EMAIL_FROM=Vowntil <alerts@your-domain.com>
VOWNTIL_EMAIL_REPLY_TO=
RESEND_API_KEY=
# Optional: absolute path to the read-only foods.sqlite used by server-side food resolution.
# If blank, the server will look in ../Nomva/Resources/foods.sqlite and ../Resources/foods.sqlite.
FOODS_DB_PATH=
APP_ATTEST_BUNDLE_ID=com.nomva.app
APP_ATTEST_TEAM_ID=9UXM4W53T6
APP_ATTEST_ALLOW_DEVELOPMENT=1
ALLOW_SIMULATOR_AUTH=0
#
# Current Nomva Cloud Garmin integration uses OAuth 1.0a.
# Keep these variable names aligned with server/index.js.
#
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_REQUEST_TOKEN_URL=https://connectapi.garmin.com/oauth-service/oauth/request_token
GARMIN_AUTHORIZE_URL=https://connect.garmin.com/oauthConfirm
GARMIN_ACCESS_TOKEN_URL=https://connectapi.garmin.com/oauth-service/oauth/access_token
GARMIN_REDIRECT_URI=https://nomva.nerdquad.com/garmin/callback
GARMIN_WEBHOOK_SHARED_SECRET=
GARMIN_USER_ID_URL=https://healthapi.garmin.com/wellness-api/rest/user/id
GARMIN_USER_PERMISSIONS_URL=https://healthapi.garmin.com/wellness-api/rest/user/permissions
GARMIN_USER_REGISTRATION_URL=https://healthapi.garmin.com/wellness-api/rest/user/registration
